# Build outputs, downloads and prepared sources (platform/build/, firmware/build/, ...).
**/build/
__pycache__/
*.py[cod]
**/.venv*/
/.vscode/

# Per-unit data never belongs in the repository: NAND backups, calibration,
# keys and captures live under ~/.local/share/w1700k/ (see init/README.md).
*.pem
*.key
nand.bin
nand-raw.bin
nand-raw.json
eeprom.bin
/captures/

# Private XR1710G runtime artifacts and per-unit material.
*.itb
*.raw
*.meta
*.log
*.zip
*.tar.gz
*eeprom*.bin
*dsd*.bin
id_ed25519*
id_rsa*
dropbear_*_host_key
/private-unit/
/runtime/
